{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|svg|webp|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/accueil", "destination": "/", "permanent": true },
    { "source": "/hotellerie", "destination": "/", "permanent": true },
    { "source": "/fiduciaire", "destination": "/", "permanent": true },
    { "source": "/dentaire", "destination": "/", "permanent": true },
    { "source": "/horlogerie", "destination": "/", "permanent": true },
    { "source": "/ia-hotellerie-suisse-romande", "destination": "/", "permanent": true },
    { "source": "/ia-suisse-vs-americaine-pme", "destination": "/", "permanent": true },
    { "source": "/choisir-agence-ia-nlpd-suisse-romande", "destination": "/", "permanent": true },
    { "source": "/agents", "destination": "/offre", "permanent": true },
    { "source": "/agent-conversation", "destination": "/offre", "permanent": true },
    { "source": "/agent-documents", "destination": "/offre", "permanent": true },
    { "source": "/agent-veille", "destination": "/offre", "permanent": true },
    { "source": "/agent-commerciaux", "destination": "/offre", "permanent": true },
    { "source": "/agent-analytiques", "destination": "/offre", "permanent": true },
    { "source": "/agent-traduction", "destination": "/offre", "permanent": true },
    { "source": "/agent-sur-mesure", "destination": "/offre", "permanent": true }
  ]
}
